# Auth.js — generate with: openssl rand -base64 32
# https://generate-secret.vercel.app/32
AUTH_SECRET=****

# Primary model — free key from https://console.groq.com/keys
# Server-only: never expose this in the browser or NEXT_PUBLIC_* vars.
GROQ_API_KEY=****

# Optional failover — free key from https://aistudio.google.com/apikey
# Used automatically when Groq fails, and for the Gemini Flash model picker option.
GOOGLE_GENERATIVE_AI_API_KEY=****

# Database — required for chat history (Neon free tier works on Vercel Hobby)
POSTGRES_URL=****

# Optional: file uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=****

# Optional: shared Redis (Upstash / Vercel Redis)
# - Cross-instance IP rate limits when running multiple server instances
# - Resumable chat streams
# Without REDIS_URL, production still enforces a per-instance in-memory IP cap (fail-closed).
REDIS_URL=****
